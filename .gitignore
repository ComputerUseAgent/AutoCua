# User data — lives OUTSIDE the install folder so an uninstall can't destroy it
# (the installer's [UninstallDelete] wipes all of {app}). `python main.py` puts
# it at the repo root; the packaged build uses <home>/AutoCua_data. The default
# skills are tracked inside the package (AutoCua/default_skills/), so nothing
# under here is tracked except vault/README.md (the credentials.json format).
/AutoCua_data/*
!/AutoCua_data/vault/
/AutoCua_data/vault/*
!/AutoCua_data/vault/README.md

# LEGACY chat location (pre-AutoCua_data) — kept ignored until every checkout has
# migrated, so a contributor who pulls this change before launching the app can't
# commit real chat transcripts still sitting in the package folder.
/AutoCua/agent_conversation/index.json
/AutoCua/agent_conversation/chat_*/
automation_grant.json
AutoCua/ios_connector/paired_devices.json
# cargo's build of the one Rust crate (AutoCua/Cargo.toml: the web agent, the
# Android agent and the coder).
/AutoCua/target
# The old per-agent builds, from before the three crates became one: no longer
# used, safe to delete.
/AutoCua/web/target
/AutoCua/android/target
/AutoCua/coder/target
/AutoCua/mac/scratchpad
/AutoCua/linux/scratchpad
/AutoCua/windows/scratchpad
/AutoCua/web/scratchpad
/AutoCua/ios/scratchpad
# WebDriverAgent's old place; it lives in AutoCua_data/WebDriverAgent now (utils/wda.py).
/AutoCua/ios_connector/WebDriverAgent
# Google's adb, fetched on first use (android_connector/adb.py), and its staging folder.
/AutoCua/android_connector/platform-tools
/AutoCua/android_connector/.platform-tools.incoming.*
# scrcpy's server, fetched by older versions (android_connector/stream.py before the helper took the screenshots): no longer used, safe to delete.
/AutoCua/android_connector/scrcpy-server-v*
/AutoCua/android_connector/.scrcpy-server.incoming.*
# Staging file of a helper build (android_connector/build_helper.py); only outlives a crash.
/AutoCua/android_connector/.autocua-helper.jar.*
# The Android agent's scratchpad.
/AutoCua/android/scratchpad
# The coder's scratchpad (todo, plan, notes and subagent results, one folder
# per run).
/AutoCua/coder/scratchpad

# Local-only tooling (never pushed)
/sync.py

# Interception SDK — the kernel-level input driver used for UAC interaction.
# Third-party vendored download (installer, library, samples), not our source;
# it lands here per-machine and has no business in the repo.
/Interception/

# The Chromium desktop shell's npm install (AutoCua/desktop/package-lock.json is kept)
/AutoCua/desktop/node_modules/
# The UI's npm install (AutoCua/ui/package-lock.json is kept; the build, AutoCua/ui/index.js, is committed)
/AutoCua/ui/node_modules/
# LEGACY shell location (desktop/ at the repo root, before it moved into the
# package) — kept ignored until every checkout has moved or deleted its npm
# install, so a pull can't turn it into untracked files.
/desktop/node_modules/

# The website demo (website/): the real UI driven by a stubbed backend, for
# recording the clip that goes on the site. It is not part of the app, and the
# mp4s it produces are big. Written up in
# note/handoffs/WEBSITE_COMPONENTS_HANDOFF.md.
/website/
